{
	"compilerOptions": {
		"moduleResolution": "bundler",
		"target": "es2022",
		"module": "es2022",
		"lib": ["es2022", "dom", "dom.iterable"],
		"checkJs": true,
		"allowJs": true,
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src/**/*.d.ts", "src/**/*.js", "src/**/*.svelte"]
}
